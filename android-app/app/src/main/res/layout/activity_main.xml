<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela única do app, em camadas (de baixo para cima):
      1. PlayerView (Media3/ExoPlayer): desenha o vídeo nativo.
      2. WebView, transparente: desenha a interface web e deixa o vídeo aparecer por trás.
      3. ImageView da abertura (splashScreen): cobre a WebView até a interface avisar que carregou.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Vídeo nativo. Sem controles: a interface web desenha a própria barra de tempo. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Interface web, ocupando todo o espaço, por cima do vídeo. -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Imagem de abertura por cima de tudo. Não recebe foco: o controle remoto continua indo para a WebView. -->
    <ImageView
        android:id="@+id/splashScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/splash" />

</FrameLayout>
