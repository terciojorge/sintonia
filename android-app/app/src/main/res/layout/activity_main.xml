<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela única do app, em camadas:
      1. PlayerView (Media3/ExoPlayer) no fundo: desenha o vídeo nativo.
      2. WebView por cima, transparente: desenha a interface web e deixa o vídeo aparecer por trás.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Vídeo nativo. Sem controles: a interface web desenha a própria barra de tempo. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Interface web, ocupando todo o espaço, por cima do vídeo. -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</FrameLayout>
